      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function startAssessment() {
      currentStepIndex = 0;
      renderWizardStep();
      showScreen("assessmentScreen");
    }

    function isSubcategoryComplete(stepIdx) {
      const sub = SUBCATEGORIES[stepIdx];
      for (let q = sub.startQ; q <= sub.endQ; q++) {
        if (answers[q] === undefined) return false;
      }
      return true;
    }

    function updateProgressUI() {
      const answeredCount = Object.keys(answers).length;
      const pct = Math.round((answeredCount / 52) * 100);
      document.getElementById("wizardProgressText").textContent = `ตอบแล้ว ${answeredCount} / 52 ข้อ (${pct}%)`;
      document.getElementById("wizardProgressBar").style.width = `${pct}%`;

      const nav = document.getElementById("stepPillsNav");
      nav.innerHTML = "";
      SUBCATEGORIES.forEach((sub, idx) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "step-pill-btn";
        if (idx === currentStepIndex) {
          btn.classList.add("current");
        } else if (isSubcategoryComplete(idx)) {
          btn.classList.add("completed");
        }
        btn.textContent = `${sub.code} ${sub.shortName}`;
        btn.onclick = () => {
          if (idx <= currentStepIndex || isSubcategoryComplete(idx) || isSubcategoryComplete(currentStepIndex)) {
            currentStepIndex = idx;
            renderWizardStep();
            window.scrollTo({ top: 0, behavior: "smooth" });
          } else {
            validateCurrentStep();
          }
        };
        nav.appendChild(btn);
      });
    }

    function renderWizardStep() {
      const sub = SUBCATEGORIES[currentStepIndex];
      document.getElementById("wizardStepTitle").textContent =
        `หมวดที่ ${currentStepIndex + 1}/9: ด้าน${sub.mainDomain} — ${sub.name}`;
      document.getElementById("subcatHeaderName").textContent = sub.name;
      document.getElementById("subcatHeaderMeta").textContent =
        `ด้าน${sub.mainDomain} • ข้อ ${sub.startQ} ถึงข้อ ${sub.endQ}`;

      document.getElementById("stepValidationAlert").classList.remove("show");

      const container = document.getElementById("questionsContainer");
      container.innerHTML = "";

      for (let qId = sub.startQ; qId <= sub.endQ; qId++) {
        const qObj = QUESTIONS.find(item => item.id === qId);
        const itemDiv = document.createElement("div");
        itemDiv.className = "question-item";
        itemDiv.id = `q-item-${qId}`;

        const headerDiv = document.createElement("div");
        headerDiv.className = "question-header";
        headerDiv.innerHTML = `
          <span class="q-number-badge">${qId}</span>
          <div class="q-text">${qObj.text}</div>
        `;

        const optionsGrid = document.createElement("div");
        optionsGrid.className = "options-grid";

        CHOICE_LABELS.forEach((label, choiceIdx) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "choice-btn" + (answers[qId] === choiceIdx ? " selected" : "");
          btn.innerHTML = `
            <span class="choice-check">✓</span>
            <span>${label}</span>
          `;
          btn.onclick = () => selectAnswer(qId, choiceIdx);
          optionsGrid.appendChild(btn);
        });

        itemDiv.appendChild(headerDiv);
        itemDiv.appendChild(optionsGrid);
        container.appendChild(itemDiv);
      }

      // Footer buttons
      const prevBtn = document.getElementById("prevStepBtn");
      const nextBtn = document.getElementById("nextStepBtn");

      if (currentStepIndex === 0) {
        prevBtn.textContent = "← กลับหน้าคำแนะนำ";
      } else {
        prevBtn.textContent = "← หมวดก่อนหน้า";
      }

      if (currentStepIndex === SUBCATEGORIES.length - 1) {
        nextBtn.textContent = "ส่งคำตอบและดูผลประเมิน ✓";
      } else {
        nextBtn.textContent = "หมวดถัดไป →";
      }

      updateProgressUI();
    }

    function selectAnswer(qId, choiceIdx) {
      answers[qId] = choiceIdx;
      const itemEl = document.getElementById(`q-item-${qId}`);
      if (itemEl) {
        itemEl.classList.remove("unanswered-error");
        const buttons = itemEl.querySelectorAll(".choice-btn");
        buttons.forEach((b, i) => {
          if (i === choiceIdx) b.classList.add("selected");
          else b.classList.remove("selected");
        });
      }

      if (isSubcategoryComplete(currentStepIndex)) {
        document.getElementById("stepValidationAlert").classList.remove("show");
      }
      updateProgressUI();
    }

    function validateCurrentStep() {
      const sub = SUBCATEGORIES[currentStepIndex];
      let firstMissingId = null;

      for (let qId = sub.startQ; qId <= sub.endQ; qId++) {
        const el = document.getElementById(`q-item-${qId}`);
        if (answers[qId] === undefined) {
          if (el) el.classList.add("unanswered-error");
          if (firstMissingId === null) firstMissingId = qId;
        } else {
          if (el) el.classList.remove("unanswered-error");
        }
      }

      if (firstMissingId !== null) {
        document.getElementById("stepValidationAlert").classList.add("show");
        const target = document.getElementById(`q-item-${firstMissingId}`);
        if (target) target.scrollIntoView({ behavior: "smooth", block: "center" });
        return false;
      }
      return true;
    }

    function prevStep() {
      if (currentStepIndex > 0) {
        currentStepIndex--;
        renderWizardStep();
        window.scrollTo({ top: 0, behavior: "smooth" });
      } else {
        showScreen("welcomeScreen");
      }
    }

    function nextStep() {
      if (!validateCurrentStep()) return;

      if (currentStepIndex < SUBCATEGORIES.length - 1) {
        currentStepIndex++;
        renderWizardStep();
        window.scrollTo({ top: 0, behavior: "smooth" });
      } else {
        renderResultsDashboard();
        showScreen("resultScreen");
      }
    }

    function evaluateResults() {
      return SUBCATEGORIES.map(sub => {
        let sum = 0;
        for (let q = sub.startQ; q <= sub.endQ; q++) {
          sum += calculateItemScore(q, answers[q]);
        }
        const [minNorm, maxNorm] = sub.norms[selectedAgeGroup];
        let statusKey = "normal";
        let statusLabel = "อยู่ในเกณฑ์ปกติ";
        if (sum < minNorm) {
          statusKey = "low";
          statusLabel = "ต่ำกว่าเกณฑ์ปกติ (ควรพัฒนาเพิ่มเติม)";
        } else if (sum > maxNorm) {
          statusKey = "high";
          statusLabel = "สูงกว่าเกณฑ์ปกติ";
        }
        return {
          ...sub,
          score: sum,
          minNorm,
          maxNorm,
          statusKey,
          statusLabel
        };
      });
    }

    function renderResultsDashboard() {
      const results = evaluateResults();
      const now = new Date();
      const thaiDate = now.toLocaleDateString("th-TH", {
        year: "numeric",
        month: "long",
        day: "numeric"
      });

      document.getElementById("reportAgeBadge").textContent =
        `เกณฑ์อายุ: ${selectedAgeGroup === "18-25" ? "18–25 ปี" : "26–60 ปี"}`;
      document.getElementById("reportDateBadge").textContent = `วันที่ประเมิน: ${thaiDate}`;
      document.getElementById("chartHeadingTitle").textContent =
        `กราฟความฉลาดทางอารมณ์ (อายุ ${selectedAgeGroup} ปี)`;
      document.getElementById("tableNormColHeader").textContent =
        `ช่วงคะแนนปกติ (${selectedAgeGroup} ปี)`;

      // Render Summary Table with 3 Main Categories rowspans
      const tbody = document.getElementById("summaryTableBody");
      tbody.innerHTML = "";

      results.forEach((res, idx) => {
        const tr = document.createElement("tr");
        let mainCellHtml = "";
        if (idx === 0 || idx === 3 || idx === 6) {
          mainCellHtml = `<td class="main-domain-cell" rowspan="3">ด้าน${res.mainDomain}</td>`;
        }
        tr.innerHTML = `
          ${mainCellHtml}
          <td><strong>${res.name}</strong></td>
          <td class="num">ข้อ ${res.startQ}–${res.endQ}</td>
          <td class="num"><strong style="font-size: 17px; color: var(--brand-deep);">${res.score}</strong> <span style="color: var(--muted); font-size: 13px;">/ ${res.maxScore}</span></td>
          <td class="num">${res.minNorm} – ${res.maxNorm}</td>
          <td class="num"><span class="status-badge ${res.statusKey}">${res.statusLabel}</span></td>
        `;
        tbody.appendChild(tr);
      });

      // Render Item-by-Item Breakdown
      const itemBody = document.getElementById("itemBreakdownBody");
      itemBody.innerHTML = "";
      QUESTIONS.forEach(q => {
        const choiceIdx = answers[q.id];
        const score = calculateItemScore(q.id, choiceIdx);
        const isGroup1 = GROUP_1_ITEMS.has(q.id);
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td class="num"><strong>${q.id}</strong></td>
          <td>${q.text}</td>
          <td class="num">กลุ่มที่ ${isGroup1 ? "1" : "2"}</td>
          <td class="num">${CHOICE_LABELS[choiceIdx] || "-"}</td>
          <td class="num"><strong>${score}</strong></td>
        `;
        itemBody.appendChild(tr);
      });

      // Render SVG Charts
      renderProfileChartSVG(results);
      renderRadarChartSVG(results);
    }

    function renderProfileChartSVG(results) {
      const width = 880;
      const rowHeight = 42;
      const topPad = 48;
      const bottomPad = 24;
      const leftLabelWidth = 310;
      const rightPad = 36;
      const plotWidth = width - leftLabelWidth - rightPad;
      const height = topPad + results.length * rowHeight + bottomPad;

      const xForVal = (val) => leftLabelWidth + (val / 25) * plotWidth;

      let svg = `<svg id="eqProfileSvg" viewBox="0 0 ${width} ${height}" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" style="font-family: 'Sarabun', 'Prompt', sans-serif; background: #FFFFFF; border-radius: 8px;">`;

      // Outer border matching the original PDF chart frame
      svg += `<rect x="10" y="38" width="${width - 20}" height="${results.length * rowHeight}" fill="none" stroke="#00A8EB" stroke-width="1.8"/>`;

      // Scale ticks 0..25 at top
      for (let v = 0; v <= 25; v++) {
        const x = xForVal(v);
        const isMajor = v % 5 === 0;
        const tickH = isMajor ? 10 : 5;
        svg += `<line x1="${x}" y1="${38 - tickH}" x2="${x}" y2="38" stroke="#00A8EB" stroke-width="${isMajor ? 1.8 : 1.1}"/>`;
        if (isMajor) {
          svg += `<text x="${x}" y="22" text-anchor="middle" fill="#0077B6" font-size="13" font-weight="700">${v}</text>`;
        }
      }

      const points = [];

      results.forEach((r, i) => {
        const rowTop = topPad - 10 + i * rowHeight;
        const rowCenterY = rowTop + rowHeight / 2;

        // Horizontal row divider
        if (i > 0) {
          svg += `<line x1="10" y1="${rowTop}" x2="${width - 10}" y2="${rowTop}" stroke="#B3DDF5" stroke-width="1"/>`;
        }

        // Normative shaded box (#E5F3FC)
        const normX1 = xForVal(r.minNorm);
        const normX2 = xForVal(r.maxNorm);
        svg += `<rect x="${normX1}" y="${rowTop + 2}" width="${normX2 - normX1}" height="${rowHeight - 4}" fill="#E5F3FC" />`;

        // Dashed horizontal guide line on 0..25
        svg += `<line x1="${xForVal(0)}" y1="${rowCenterY}" x2="${xForVal(25)}" y2="${rowCenterY}" stroke="#00A8EB" stroke-width="1.3" stroke-dasharray="5,5"/>`;

        // Subcategory label & normal range text on left
        svg += `<text x="22" y="${rowCenterY + 5}" fill="#005C85" font-size="14" font-weight="600">${r.name}</text>`;
        svg += `<text x="175" y="${rowCenterY + 5}" fill="#0082B8" font-size="13.5">ช่วงคะแนนปกติ = ${r.minNorm}-${r.maxNorm}</text>`;

        // Collect user score coordinate
        const sx = xForVal(r.score);
        points.push({ x: sx, y: rowCenterY, score: r.score, statusKey: r.statusKey });
      });

      // Vertical divider between labels and graph scale
      svg += `<line x1="${leftLabelWidth}" y1="38" x2="${leftLabelWidth}" y2="${38 + results.length * rowHeight}" stroke="#00A8EB" stroke-width="1.5"/>`;

      // Connected profile polyline
      const polyPoints = points.map(p => `${p.x},${p.y}`).join(" ");
      svg += `<polyline points="${polyPoints}" fill="none" stroke="#005C85" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>`;

      // Score markers & value labels
      points.forEach(p => {
        let dotFill = "#00A8EB";
        if (p.statusKey === "low") dotFill = "#F59E0B";
        if (p.statusKey === "high") dotFill = "#10B981";

        svg += `<circle cx="${p.x}" cy="${p.y}" r="6.5" fill="${dotFill}" stroke="#FFFFFF" stroke-width="2"/>`;
        svg += `<circle cx="${p.x}" cy="${p.y}" r="6.5" fill="none" stroke="#005C85" stroke-width="1.5"/>`;
        svg += `<rect x="${p.x + 10}" y="${p.y - 11}" width="26" height="20" rx="4" fill="#005C85"/>`;
        svg += `<text x="${p.x + 23}" y="${p.y + 4}" text-anchor="middle" fill="#FFFFFF" font-size="12" font-weight="700">${p.score}</text>`;
      });

      svg += `</svg>`;
      document.getElementById("profileSvgMount").innerHTML = svg;
    }

    function renderRadarChartSVG(results) {
      const size = 500;
      const cx = size / 2;
      const cy = size / 2;
      const radius = 165;
      const n = results.length;

      const getCoord = (idx, ratio) => {
        const angle = -Math.PI / 2 + (idx * 2 * Math.PI) / n;
        return {
          x: cx + radius * ratio * Math.cos(angle),
          y: cy + radius * ratio * Math.sin(angle)
        };
      };

      let svg = `<svg viewBox="0 0 ${size} ${size}" width="100%" style="max-width: 500px; height: auto; font-family: 'Sarabun', 'Prompt', sans-serif;">`;

      // Concentric web rings (25%, 50%, 75%, 100%)
      [0.25, 0.5, 0.75, 1.0].forEach(level => {
        const ringPts = results.map((_, i) => {
          const c = getCoord(i, level);
          return `${c.x},${c.y}`;
        }).join(" ");
        svg += `<polygon points="${ringPts}" fill="none" stroke="#D5E6F2" stroke-width="1.2"/>`;
      });

      // Axes & labels
      results.forEach((r, i) => {
        const end = getCoord(i, 1.0);
        const labelPos = getCoord(i, 1.22);
        svg += `<line x1="${cx}" y1="${cy}" x2="${end.x}" y2="${end.y}" stroke="#B3DDF5" stroke-width="1.2"/>`;
        svg += `<text x="${labelPos.x}" y="${labelPos.y + 4}" text-anchor="middle" fill="#005C85" font-size="12.5" font-weight="700">${r.code} ${r.shortName}</text>`;
      });

      // Normative max & min polygons
      const maxNormPts = results.map((r, i) => {
        const c = getCoord(i, r.maxNorm / r.maxScore);
        return `${c.x},${c.y}`;
      }).join(" ");
      const minNormPts = results.map((r, i) => {
        const c = getCoord(i, r.minNorm / r.maxScore);
        return `${c.x},${c.y}`;
      }).join(" ");

      svg += `<polygon points="${maxNormPts}" fill="rgba(0, 168, 235, 0.16)" stroke="#00A8EB" stroke-width="1.5" stroke-dasharray="4,4"/>`;
      svg += `<polygon points="${minNormPts}" fill="#FFFFFF" stroke="#00A8EB" stroke-width="1.5" stroke-dasharray="4,4"/>`;

      // User score polygon
      const userPts = results.map((r, i) => {
        const c = getCoord(i, r.score / r.maxScore);
        return `${c.x},${c.y}`;
      }).join(" ");
      svg += `<polygon points="${userPts}" fill="rgba(0, 92, 133, 0.22)" stroke="#005C85" stroke-width="2.8"/>`;

      results.forEach((r, i) => {
        const c = getCoord(i, r.score / r.maxScore);
        svg += `<circle cx="${c.x}" cy="${c.y}" r="5" fill="#00A8EB" stroke="#005C85" stroke-width="2"/>`;
      });

      svg += `</svg>`;
      document.getElementById("radarSvgMount").innerHTML = svg;
    }

    function switchChartView(mode) {
      const profileBox = document.getElementById("profileChartContainer");
      const radarBox = document.getElementById("radarChartContainer");
      const tabProfile = document.getElementById("tabProfileBtn");
      const tabRadar = document.getElementById("tabRadarBtn");

      if (mode === "profile") {
        profileBox.style.display = "block";
        radarBox.style.display = "none";
        tabProfile.classList.add("active");
        tabRadar.classList.remove("active");
      } else {
        profileBox.style.display = "none";
        radarBox.style.display = "block";
        tabRadar.classList.add("active");
        tabProfile.classList.remove("active");
      }
    }

    function resetAssessment() {
      answers = {};
      currentStepIndex = 0;
      showScreen("welcomeScreen");
    }

    // Export as PDF / Print
    function exportReportPDF() {
      window.print();
    }

    // Export High-Resolution PNG Summary Card using HTML5 Canvas
    function downloadReportImage() {
      const results = evaluateResults();
      const canvas = document.createElement("canvas");
      const W = 1200;
      const H = 1320;
      canvas.width = W;
      canvas.height = H;
      const ctx = canvas.getContext("2d");

      // Background
      ctx.fillStyle = "#FFFFFF";
      ctx.fillRect(0, 0, W, H);

      // Top Header Banner (#00A8EB)
      ctx.fillStyle = "#00A8EB";
      ctx.fillRect(0, 0, W, 115);

      ctx.fillStyle = "#FFFFFF";
      ctx.font = "bold 30px 'Sarabun', sans-serif";
      ctx.fillText("รายงานผลการประเมินความฉลาดทางอารมณ์ (EQ)", 40, 52);

      ctx.font = "20px 'Sarabun', sans-serif";
      const dateStr = new Date().toLocaleDateString("th-TH", { year: "numeric", month: "long", day: "numeric" });
      ctx.fillText(`กรมสุขภาพจิต กระทรวงสาธารณสุข (พ.ศ. 2543)  |  เกณฑ์อายุ: ${selectedAgeGroup} ปี  |  วันที่: ${dateStr}`, 40, 88);

      // Section 1: Profile Graph (0..25)
      ctx.fillStyle = "#005C85";
      ctx.font = "bold 22px 'Sarabun', sans-serif";
      ctx.fillText(`กราฟความฉลาดทางอารมณ์ (อายุ ${selectedAgeGroup} ปี)`, 40, 160);

      const gLeft = 420;
      const gRight = 1140;
      const gWidth = gRight - gLeft;
      const gTop = 205;
      const rowH = 48;

      const xPos = (v) => gLeft + (v / 25) * gWidth;

      // Scale numbers 0..25
      ctx.font = "bold 15px 'Sarabun', sans-serif";
      ctx.fillStyle = "#0077B6";
      ctx.textAlign = "center";
      for (let v = 0; v <= 25; v += 5) {
        ctx.fillText(String(v), xPos(v), gTop - 12);
      }
      ctx.textAlign = "left";

      // Frame box
      ctx.strokeStyle = "#00A8EB";
      ctx.lineWidth = 2;
      ctx.strokeRect(40, gTop, 1100, results.length * rowH);

      const pts = [];
      results.forEach((r, i) => {
        const yTop = gTop + i * rowH;
        const yMid = yTop + rowH / 2;

        if (i > 0) {
          ctx.strokeStyle = "#B3DDF5";
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(40, yTop);
          ctx.lineTo(1140, yTop);
          ctx.stroke();
        }

        // Norm shaded band (#E5F3FC)
        const nx1 = xPos(r.minNorm);
        const nx2 = xPos(r.maxNorm);
        ctx.fillStyle = "#E5F3FC";
        ctx.fillRect(nx1, yTop + 2, nx2 - nx1, rowH - 4);

        // Dashed line
        ctx.save();
        ctx.setLineDash([6, 6]);
        ctx.strokeStyle = "#00A8EB";
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(gLeft, yMid);
        ctx.lineTo(gRight, yMid);
        ctx.stroke();
        ctx.restore();

        // Labels
        ctx.fillStyle = "#005C85";
        ctx.font = "bold 17px 'Sarabun', sans-serif";
        ctx.fillText(r.name, 56, yMid + 6);

        ctx.fillStyle = "#0082B8";
        ctx.font = "16px 'Sarabun', sans-serif";
        ctx.fillText(`ช่วงคะแนนปกติ = ${r.minNorm}-${r.maxNorm}`, 245, yMid + 6);

        pts.push({ x: xPos(r.score), y: yMid, score: r.score });
      });

      // Connect points
      ctx.strokeStyle = "#005C85";
      ctx.lineWidth = 3.5;
      ctx.beginPath();
      pts.forEach((p, idx) => {
        if (idx === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      });
      ctx.stroke();

      pts.forEach(p => {
        ctx.fillStyle = "#00A8EB";
        ctx.beginPath();
        ctx.arc(p.x, p.y, 7, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "#005C85";
        ctx.lineWidth = 2;
        ctx.stroke();

        ctx.fillStyle = "#005C85";
        ctx.font = "bold 15px 'Sarabun', sans-serif";
        ctx.fillText(String(p.score), p.x + 12, p.y + 5);
      });

      // Section 2: Summary Table
      const tTop = gTop + results.length * rowH + 55;
      ctx.fillStyle = "#005C85";
      ctx.font = "bold 22px 'Sarabun', sans-serif";
      ctx.fillText("ตารางสรุปคะแนนและผลการประเมินรายด้าน", 40, tTop - 16);

      // Table Header
      ctx.fillStyle = "#00A8EB";
      ctx.fillRect(40, tTop, 1100, 44);
      ctx.fillStyle = "#FFFFFF";
      ctx.font = "bold 17px 'Sarabun', sans-serif";
      ctx.fillText("ด้านหลัก", 65, tTop + 28);
      ctx.fillText("ด้านย่อย", 200, tTop + 28);
      ctx.fillText("คะแนนที่ได้", 540, tTop + 28);
      ctx.fillText("ช่วงคะแนนปกติ", 720, tTop + 28);
      ctx.fillText("ผลการแปลผล", 910, tTop + 28);

      const tRowH = 46;
      results.forEach((r, i) => {
        const ry = tTop + 44 + i * tRowH;
        ctx.fillStyle = i % 2 === 0 ? "#FFFFFF" : "#F4F9FD";
        ctx.fillRect(40, ry, 1100, tRowH);
        ctx.strokeStyle = "#D5E6F2";
        ctx.lineWidth = 1;
        ctx.strokeRect(40, ry, 1100, tRowH);

        ctx.fillStyle = "#005C85";
        ctx.font = "bold 16px 'Sarabun', sans-serif";
        ctx.fillText(`ด้าน${r.mainDomain}`, 65, ry + 29);

        ctx.fillStyle = "#112233";
        ctx.font = "16px 'Sarabun', sans-serif";
        ctx.fillText(r.name, 200, ry + 29);

        ctx.font = "bold 17px 'Sarabun', sans-serif";
        ctx.fillText(`${r.score} / ${r.maxScore}`, 555, ry + 29);

        ctx.font = "16px 'Sarabun', sans-serif";
        ctx.fillText(`${r.minNorm} – ${r.maxNorm}`, 750, ry + 29);

        if (r.statusKey === "low") ctx.fillStyle = "#D97706";
        else if (r.statusKey === "normal") ctx.fillStyle = "#059669";
        else ctx.fillStyle = "#0284C7";

        ctx.font = "bold 16px 'Sarabun', sans-serif";
        ctx.fillText(r.statusLabel, 910, ry + 29);
      });

      // Footer note
      const fY = tTop + 44 + results.length * tRowH + 38;
      ctx.fillStyle = "#4A6075";
      ctx.font = "15px 'Sarabun', sans-serif";
      ctx.fillText("หมายเหตุ: คะแนนที่ได้ต่ำกว่าช่วงคะแนนปกติ ไม่ได้หมายความว่ามีความผิดปกติ แต่เป็นข้อเตือนใจให้หาแนวทางพัฒนาความฉลาดทางอารมณ์ในด้านนั้น ๆ ให้มากยิ่งขึ้น", 40, fY);

      // Trigger PNG download
      const dataUrl = canvas.toDataURL("image/png");
      const link = document.createElement("a");
      link.download = `ผลประเมิน-EQ-${selectedAgeGroup}-${Date.now()}.png`;
      link.href = dataUrl;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
  </script>
</body>
