      if (choiceIdx === undefined || choiceIdx === null) return 0;
      if (GROUP_1_ITEMS.has(qId)) {
        return choiceIdx + 1; // 1, 2, 3, 4
      } else {
        return 4 - choiceIdx; // 4, 3, 2, 1
      }
